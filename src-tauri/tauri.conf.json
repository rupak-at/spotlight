{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spotlight",
  "version": "0.1.0",
  "identifier": "io.github.rupak.spotlight",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Spotlight",
        "width": 680,
        "height": 96,
        "center": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "resizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "Utility",
    "shortDescription": "Search and launch applications, files, and folders",
    "homepage": "https://github.com/rupak-at/spotlight",
    "licenseFile": "../LICENSE",
    "linux": {
      "deb": {
        "section": "utils",
        "files": {
          "/usr/share/doc/spotlight/copyright": "../LICENSE"
        }
      }
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
